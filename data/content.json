    "id": "e_twsWdyo7DApw",
    "kind": "plugin",
    "title": "Session Reminder",
    "status": "published",
    "featured": false,
    "visibility": "public",
    "data": {
     "version": "1.0.0",
     "description": "Erinnert nach einer einstellbaren Spielzeit an eine Pause.",
     "permissions": [
      "notify",
      "events",
      "storage"
     ],
     "polaris": ">=1.0.0",
     "author": "Polaris",
     "code": "let minutes = 60;\npolaris.storage.get('minutes').then(v => { if (v) minutes = v; });\npolaris.onEvent('game:start', () => { setTimeout(() => polaris.notify('Du spielst seit ' + minutes + ' Minuten – Zeit für eine Pause.'), minutes * 60000); });\npolaris.notify('Session Reminder aktiv');"
    },
